# Public values are embedded in the browser bundle. Set them as both build-time
# and runtime variables in Coolify.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# PostgreSQL is the authoritative store for legislative records and audit data.
DATABASE_URL=postgresql://legiscore:change-me@localhost:5432/legiscore?schema=public

# Server-only secret. Never prefix this with NEXT_PUBLIC_.
APPWRITE_API_KEY=

# Resource IDs can be filled in after the Appwrite schema is created.
APPWRITE_DATABASE_ID=
APPWRITE_LEGISLATION_COLLECTION_ID=
APPWRITE_LEGISLATORS_COLLECTION_ID=
APPWRITE_STORAGE_BUCKET_ID=

# Server-only AI provider configuration. Never expose the API key with a
# NEXT_PUBLIC_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=LegisCore Nigeria

# Optional bootstrap mapping. Set these only when seeding a development database.
LEGISCORE_SEED_APPWRITE_USER_ID=
LEGISCORE_SEED_ADMIN_EMAIL=
